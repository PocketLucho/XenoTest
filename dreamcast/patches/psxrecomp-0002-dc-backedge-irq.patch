From eccb82c72e5a5d394b8dc5adac2959039707dcd8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 23:02:13 +0000
Subject: [PATCH] dc target: poll interrupts on back-edges only

Drop the interrupt poll on forward branches with a constant target that has
not been emitted yet; back-edges, calls, dispatch and returns still poll.
PSXRECOMP_DC_IRQ_ALL_BRANCHES=1 restores a poll on every branch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011whdg2yDfX3EoxgBeZLS6B
---
 docs/DREAMCAST_TARGET.md     | 28 +++++++++++++++++++++++-----
 recompiler/src/dc_target.cpp | 29 +++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+), 5 deletions(-)

diff --git a/docs/DREAMCAST_TARGET.md b/docs/DREAMCAST_TARGET.md
index bb3f994..f4014d1 100644
--- a/docs/DREAMCAST_TARGET.md
+++ b/docs/DREAMCAST_TARGET.md
@@ -15,6 +15,10 @@ What the DC output does (`recompiler/src/dc_target.cpp`):
    interrupt service and returns, and reloaded after them.
 3. `if (psx_check_interrupts_at(cpu, X)) return;` shares one cold write-back stub
    per function (computed goto), so the register cache does not grow code size.
+4. Interrupts are polled on back-edges only: a check whose constant target label
+   has not been emitted yet (a forward branch) is dropped, since every forward
+   path reaches a back-edge, call, dispatch or return. Set
+   `PSXRECOMP_DC_IRQ_ALL_BRANCHES=1` when generating to keep a poll on every branch.
 
 Memory model: by default main RAM (mirrored to 8 MB) and the scratchpad are
 inline and everything else calls `dc_*_slow()`. With `-DDC_GUEST_RAM_MMU` every
@@ -30,17 +34,31 @@ ordering-table build, LZ decompression):
 |---|---|---|---|---|
 | PC output, faithful timing (hooks stubbed) | 166 | 174 | 207 | — |
 | PC output, no cycle timing | 9.2 | 9.5 | 10.4 | 23 |
-| `--target dc` | 6.4 | 5.1 | 5.2 | 17 |
-| `--target dc` + `DC_GUEST_RAM_MMU` | 5.5 | 4.5 | 3.9 | 16 |
+| `--target dc`, poll on every branch | 6.4 | 5.1 | 5.2 | 17 |
+| same + `DC_GUEST_RAM_MMU` | 5.5 | 4.5 | 3.9 | 16 |
+| `--target dc` (back-edge polling) + `DC_GUEST_RAM_MMU` | 5.2 | 3.3 | 3.4 | 15 |
 | Same C compiled natively for SH-4 | 3.7 | 1.3 | 1.3 | 2.5 |
 
 The LZ case is dominated by function fragmentation (loop blocks emitted as
 separate functions re-entered through dispatch).
 
+Xenogears (USA-serial disc-1 EXE) main executable compiled for SH-4:
+
+| Output | Size |
+|---|---|
+| PC output, no cycle timing | 5.45 MB |
+| `--target dc` (back-edge polling) | 3.34 MB |
+| same + `DC_GUEST_RAM_MMU` | 2.03 MB |
+
+Interrupt poll sites drop from 17,771 to 2,181.
+
 ## Still to do
 
-- Do not split functions at internal branch targets.
+- Function fragmentation. Two causes seen in the benchmark: a JAL target whose
+  prologue is preceded by setup code becomes an 8-byte function plus a separate
+  prologue function, and jump-table case targets become function entries that
+  each span to the end of the switch (duplicating the switch body and routing
+  cases through dispatch). Xenogears shows 537 fallthroughs into the next
+  function and 108 out-of-function branches.
 - Drop entry resume switches that nothing can reach.
-- Poll interrupts on back-edges and calls only (upper bound measured: VM 2.4,
-  OT 3.1).
 - A KallistiOS runtime: dispatch, GTE, CD, GPU translation, SPU→AICA.
diff --git a/recompiler/src/dc_target.cpp b/recompiler/src/dc_target.cpp
index f24d2b4..7b93c2f 100644
--- a/recompiler/src/dc_target.cpp
+++ b/recompiler/src/dc_target.cpp
@@ -21,6 +21,7 @@
 #include "dc_target_pass.h"
 
 #include <cctype>
+#include <cstdlib>
 #include <set>
 #include <string>
 #include <vector>
@@ -236,13 +237,41 @@ std::string rewrite_body(const std::string& body, std::set<int>& used_out) {
     int irq_sites = 0;
     static const std::string irq_stmt = "if (psx_check_interrupts_at(cpu, ";
     static const std::string irq_expr = "psx_check_interrupts_at(cpu,";
+    // Block labels already emitted above the current point. A check whose
+    // constant target is not among them is a forward branch: it is dropped,
+    // because every forward path reaches a back-edge, a call, a dispatch or a
+    // return, which still poll. Set PSXRECOMP_DC_IRQ_ALL_BRANCHES=1 to keep
+    // the reference behaviour of polling on every branch.
+    static const bool poll_all = [] {
+        const char* v = std::getenv("PSXRECOMP_DC_IRQ_ALL_BRANCHES");
+        return v && *v && *v != '0';
+    }();
+    std::set<std::string> seen_labels;
     for (size_t i = 0; i < body.size();) {
+        if ((i == 0 || body[i - 1] == '\n') &&
+            (starts_with_at(body, i, "block_") || starts_with_at(body, i, "label_"))) {
+            size_t p = i + 6;
+            while (p < body.size() && std::isxdigit(static_cast<unsigned char>(body[p]))) ++p;
+            if (p == i + 14 && p < body.size() && body[p] == ':') {
+                seen_labels.insert(body.substr(i + 6, 8));
+            }
+        }
         if (body.compare(i, irq_stmt.size(), irq_stmt) == 0) {
             size_t arg = i + irq_stmt.size();
             size_t close = body.find(')', arg);
             size_t lparen = body.find('(', arg);
             if (close != std::string::npos && (lparen == std::string::npos || lparen > close) &&
                 body.compare(close, 10, ")) return;") == 0) {
+                const std::string target = body.substr(arg, close - arg);
+                bool constant = target.size() == 11 && target.compare(0, 2, "0x") == 0 &&
+                                target[10] == 'u';
+                for (size_t k = 2; constant && k < 10; ++k) {
+                    constant = std::isxdigit(static_cast<unsigned char>(target[k])) != 0;
+                }
+                if (!poll_all && constant && !seen_labels.count(target.substr(2, 8))) {
+                    i = close + 10;  // forward branch: no poll
+                    continue;
+                }
                 ++irq_sites;
                 const std::string n = std::to_string(irq_sites);
                 a += "if (__builtin_expect(g_irq_pending, 0)) { _dc_irq_pc = (" +
